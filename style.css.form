.qw{
 text-align: center;
  border: 2px;
  margin:2px;
  background-color:skyblue;
  padding: 2px;
}
.rr{
  margin:5px;
}
.rt{
  margin:5px;
  display: flex;
  gap: 5px;
  flex-direction: justify;
}
.ry{
  display:flex;
  flex-direction: column;
  gap: 6px;
  width: 800px;
}
.qq{
  background-color: blue;
  color: white;
  cursor: pointer;
  border-radius: 2px;
  border: 1px;
  height: 30px;
  width: 57px;
  transition: transform 0.3s ease-in-out;
}
.qq:hover{
  transform: scale(1.1);
  color: white;
  background-color:red;
}
.ty{
 color: red;
}
